{
  "name": "jobhunt",
  "version": "1.0.0",
  "type": "module",
  "description": "Clean, self-contained job-search tool: scan boards + LinkedIn, rank against your profile, find referrals.",
  "bin": { "jobhunt": "jobhunt.mjs" },
  "scripts": {
    "start": "node server.mjs",
    "hunt": "node jobhunt.mjs",
    "scan": "node scan.mjs",
    "aggregators": "node aggregators.mjs",
    "rank": "node rank.mjs",
    "rank:ai": "node rank.mjs --ai",
    "recent": "node board-recent.mjs --days 1",
    "today": "node today.mjs",
    "referrals": "node referrals.mjs",
    "liveness": "node liveness.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "js-yaml": "^4.1.0"
  }
}
